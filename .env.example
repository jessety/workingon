# Copy to `.env` and fill in. Anything omitted falls back to `.env.defaults`.

# Required — used to summarize your activity
ANTHROPIC_API_KEY=sk-ant-...

# At least one destination is required — set one or both.
# SoWork: generated in SoWork settings
SOWORK_API_KEY=sw_...
# Slack: a user token (xoxp-…) with the users.profile:write scope — see the README
# SLACK_API_TOKEN=xoxp-...

# Strongly recommended. Claude Code sends this as `Authorization: Bearer <token>`.
# Without it, any local process can post activity to this service.
HOOK_TOKEN=pick-a-long-random-string

# Optional overrides
# PORT=8220
# HOST=127.0.0.1     # 0.0.0.0 to accept hooks from other machines
# SUMMARY_INTERVAL_MINUTES=10
# SUMMARY_MAX_LENGTH=100
# IDLE_CLEAR_MINUTES=30
# PLAN_DIRECTORY=          # empty disables reading plan files
# PLAN_MAX_AGE_HOURS=12
# DRY_RUN=TRUE
# VERBOSE=TRUE
