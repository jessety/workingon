{
  "testEnvironment": "node",
  "collectCoverage": true,
  "collectCoverageFrom": ["src/**/*.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node10",
          "verbatimModuleSyntax": false,
          "rootDir": "./"
        }
      }
    ]
  }
}
