{
  "name": "boilerplate-typescript-service",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "homepage": "https://github.com/jessety/boilerplate-typescript-service#readme",
  "bugs": {
    "url": "https://github.com/jessety/boilerplate-typescript-service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessety/boilerplate-typescript-service.git"
  },
  "license": "MIT",
  "author": "Jesse Youngblood",
  "type": "module",
  "main": "./build/index.js",
  "directories": {
    "lib": "build",
    "test": "test"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "build:start": "npm run build && npm run start",
    "clean": "rimraf build",
    "docker:build": "docker build -t jessety/boilerplate-typescript-service .",
    "docker:start": "docker run -p 8080:8080 --add-host=host.docker.internal:host-gateway -d jessety/boilerplate-typescript-service",
    "format": "sort-package-json && prettier --write '**/*.{ts,js,mjs,cjs,json,yml,md}' && eslint --fix --cache .",
    "lint": "eslint --cache . && ec .",
    "prepare": "husky",
    "release:major": "npm version major --no-commit-hooks && git push --follow-tags",
    "release:minor": "npm version minor --no-commit-hooks && git push --follow-tags",
    "release:patch": "npm version patch --no-commit-hooks && git push --follow-tags",
    "start": "node build/index.js",
    "start:watch": "nodemon",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jessety/prettier-config": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sort-package-json": "^4.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
