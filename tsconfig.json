{
  // https://www.typescriptlang.org/tsconfig
  "exclude": ["node_modules", "test", "build"],
  "compilerOptions": {
    /* Projects */
    "incremental": true /* Save .tsbuildinfo to allow incremental compilation */,
    "tsBuildInfoFile": "build/.tsbuildinfo",

    /* Language and Environment */
    "target": "ES2023" /* Set the JavaScript language version for emitted JavaScript */,
    "lib": ["ES2023"],

    /* Modules */
    "module": "NodeNext" /* Emit native ES modules, per "type": "module" in package.json */,
    "moduleResolution": "NodeNext" /* Resolve the way Node does — relative imports need a file extension */,
    "rootDir": "./src",
    "types": ["node"],

    /* Emit */
    "outDir": "./build",
    "sourceMap": true /* Emit a .map file alongside each .js file */,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true /* Ensure each file can be transpiled independently */,
    "verbatimModuleSyntax": true /* Emit imports exactly as written; type-only imports must say `import type` */,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true /* Add `undefined` to the type of an unchecked index access */,

    /* Completeness */
    "skipLibCheck": true
  }
}
